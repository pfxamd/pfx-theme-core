{
  "name": "@pfxamd/theme-core",
  "version": "0.3.1",
  "private": true,
  "description": "Framework-independent, dependency-free light/dark/system theme core",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./theme-init.js": "./src/theme-init.js",
    "./theme.css": "./src/theme.css",
    "./palette.js": {
      "types": "./src/palette.d.ts",
      "default": "./src/palette.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/theme-core.js && node --check src/theme-init.js && node --check src/index.js && node --check src/palette.js && node --check scripts/palette-cli.mjs && node --check scripts/vendor-core.mjs && node scripts/palette-cli.mjs check tokens/neutral.json && node --test",
    "test:browser": "node scripts/browser-tests.mjs",
    "release:version": "node .pfx/release.mjs --sync"
  },
  "license": "MIT"
}
